# ============================================================
#  Nessus AI Analyzer - Cấu hình biến môi trường
#  Sao chép file này thành .env rồi điền thông tin của bạn.
#  Lệnh:  copy .env.example .env
# ============================================================

# ── AI Provider ─────────────────────────────────────────────
# Chọn "gemini" hoặc "openai"
AI_PROVIDER=gemini

# Google Gemini API Key (lấy tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (lấy tại https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Tên model (mặc định: gemini-2.0-flash / gpt-4o)
AI_MODEL=

# ── Microsoft SQL Server ────────────────────────────────────
# Tên server (ví dụ: localhost, localhost\SQLEXPRESS, 192.168.1.10)
DB_SERVER=localhost

# Tên database (sẽ được tạo tự động bởi setup_db.py)
DB_NAME=NessusAnalyzer

# Xác thực Windows (để trống USER/PASS) hoặc SQL Auth
DB_USER=
DB_PASSWORD=

# ODBC Driver (thường là một trong các giá trị sau)
DB_DRIVER=ODBC Driver 17 for SQL Server
# Thay thế khác: ODBC Driver 18 for SQL Server, SQL Server

# ── Nessus Local API ────────────────────────────────────────
# URL của Nessus Scanner (mặc định https://localhost:8834)
NESSUS_URL=https://localhost:8834

# Xác thực bằng Username/Password
NESSUS_USERNAME=
NESSUS_PASSWORD=

# HOẶC xác thực bằng API Keys (ưu tiên hơn nếu có cả 2)
# Lấy tại: Nessus → Settings → My Account → API Keys → Generate
NESSUS_ACCESS_KEY=
NESSUS_SECRET_KEY=
